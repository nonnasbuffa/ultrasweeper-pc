{
  "appId": "com.offlineminesweeper.lite",
  "productName": "UltraSweeper Lite",
  "copyright": "UltraSweeper",
  "electronVersion": "28.1.2",
  "directories": {
    "app": "app-lite",
    "output": "dist",
    "buildResources": "build"
  },
  "asar": true,
  "npmRebuild": false,
  "win": {
    "target": [
      "portable",
      "nsis"
    ],
    "icon": "build/icon.png",
    "signAndEditExecutable": true
  },
  "portable": {
    "artifactName": "UltraSweeper-Lite.exe"
  },
  "linux": {
    "target": [
      "AppImage",
      "deb"
    ],
    "icon": "build/icon.png",
    "category": "Game",
    "maintainer": "UltraSweeper",
    "synopsis": "The classic-look UltraSweeper, light enough for older PCs",
    "executableName": "ultrasweeper-lite"
  },
  "appImage": {
    "artifactName": "UltraSweeper-Lite.AppImage"
  },
  "deb": {
    "artifactName": "UltraSweeper-Lite.deb"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": false,
    "createStartMenuShortcut": false,
    "shortcutName": "UltraSweeper Lite",
    "uninstallDisplayName": "UltraSweeper Lite",
    "include": "build/installer.nsh",
    "artifactName": "UltraSweeper-Lite-Setup.exe",
    "runAfterFinish": true
  }
}
