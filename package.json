{
  "name": "ultrasweeper-pc-build",
  "private": true,
  "description": "Packs the desktop game into UltraSweeper and UltraSweeper Lite: a Windows installer exe and a Linux .deb for each.",
  "scripts": {
    "sync": "node scripts/sync-app.js",
    "build": "electron-builder --win nsis --x64 --publish never",
    "build:linux": "electron-builder --linux deb --x64 --publish never",
    "build:lite": "electron-builder --config lite.config.json --win nsis --x64 --publish never",
    "build:lite:linux": "electron-builder --config lite.config.json --linux deb --x64 --publish never"
  },
  "devDependencies": {
    "electron-builder": "24.13.3"
  },
  "build": {
    "appId": "com.offlineminesweeper.app",
    "productName": "UltraSweeper",
    "copyright": "UltraSweeper",
    "electronVersion": "28.1.2",
    "directories": {
      "app": "app",
      "output": "dist",
      "buildResources": "build"
    },
    "asar": true,
    "npmRebuild": false,
    "win": {
      "target": "nsis",
      "icon": "build/icon.png",
      "signAndEditExecutable": true
    },
    "linux": {
      "target": [
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "Game",
      "maintainer": "UltraSweeper",
      "synopsis": "A customizable offline minesweeper game",
      "executableName": "ultrasweeper"
    },
    "deb": {
      "artifactName": "UltraSweeper.deb"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": false,
      "shortcutName": "UltraSweeper",
      "uninstallDisplayName": "UltraSweeper",
      "include": "build/installer.nsh",
      "artifactName": "UltraSweeper.exe",
      "runAfterFinish": true
    }
  }
}
